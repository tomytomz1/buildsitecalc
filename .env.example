# BuildSiteCalc environment variables
# Never commit real AdSense publisher/client IDs if you prefer env-only secrets.
# Copy to .env.local and fill in production values.
# Analytics and ads stay inactive when IDs are empty or flags are false.

# Public site URL (used for canonicals in some tooling; metadataBase also uses siteConfig.domain)
NEXT_PUBLIC_SITE_URL=https://buildsitecalc.com

# Google Analytics (leave empty to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager (leave empty to disable)
NEXT_PUBLIC_GTM_ID=

# AdSense / advertising
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=

# Affiliate modules (sponsored links stay inactive when false)
NEXT_PUBLIC_AFFILIATES_ENABLED=false

# Social profiles. Absolute URLs only. Each one set here is emitted as `sameAs`
# on the Organization JSON-LD and rendered in the footer. Leave a value empty
# until the profile actually exists: a sameAs pointing at a dead profile is an
# entity mismatch, which is worse than having no sameAs at all.
NEXT_PUBLIC_SOCIAL_TWITTER=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_PINTEREST=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
